VITE_API_BASE_URL=/api/v1
# Storefront app origin; the website and funnel editors post live previews to it.
VITE_STOREFRONT_URL=http://localhost:3000
# Root domain stores are served on; the dashboard builds each store link as <slug>.<this>.
VITE_PUBLIC_ROOT_DOMAIN=zimos.co

# Merchant-owned domains (the Domains tab in Store settings). Off unless exactly "true".
# Turn on only once the API runs with its own CUSTOM_DOMAINS_ENABLED=true: while that
# is off the API answers every domains route with 404 and the tab says the feature is
# not available. The storefront's CUSTOM_DOMAINS_ENABLED goes on with them.
VITE_CUSTOM_DOMAINS_ENABLED=false

# AI features (AI studio, AI description/translation/funnel, the WhatsApp reply bot).
# Off unless exactly "true"; turn on only after the API is deployed with AI_ENABLED.
VITE_AI_ENABLED=false

# The picture slider's newer settings in the website editor: the text's place on a
# phone, the veil over the picture, a background video. Off unless exactly "true";
# turn on together with the storefront's NEXT_PUBLIC_HERO_MEDIA_ENABLED (it draws them).
VITE_HERO_MEDIA_ENABLED=false

# The Store look's "Navigation" choice in the website editor: top bar or side
# bar. Off unless exactly "true"; turn on together with the storefront's
# NEXT_PUBLIC_STORE_SIDEBAR_ENABLED (it draws the side bar).
VITE_STORE_SIDEBAR_ENABLED=false

# A 4:3 box for the full-width pictures of a block newly added from the website
# editor's library, so any file put in fills it. Off unless exactly "true"; off,
# a new picture keeps the file's own shape, as before. Saved pages never change.
VITE_PICTURE_SHAPE_DEFAULT_ENABLED=false

# The website editor offers only the imported templates' bands and the basic
# elements, and hides Zimos's own ready styles and store themes. Off unless
# exactly "true"; off, every block, style and theme is offered as before.
VITE_XS_ONLY_ENABLED=false

# ZIMOS's social accounts on the support page from the console's "Platform settings"
# instead of the list in the code. Off unless exactly "true"; turn on once the API
# runs with PLATFORM_SETTINGS_ENABLED. The code's list still shows when the API fails.
VITE_PLATFORM_SETTINGS_ENABLED=false
